<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Invoice <%= invoice.invoice_number %></title>
  <style>
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: 12px;
      color: #333;
      margin: 20px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #f0f0f0;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }

    .header img {
      width: 120px;
    }

    .header .company-details {
      text-align: right;
      font-size: 11px;
    }

    h2 {
      margin: 5px 0;
      font-size: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 6px;
      text-align: left;
    }

    th {
      background-color: #f9f9f9;
    }

    .addresses {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
      column-gap: 40px;
    }

    .addresses div {
      width: 45%;
    }

    .addresses .billing {
      padding-left: 20px;
      border-left: 1px solid #ddd;
    }

    .total-table th,
    .total-table td {
      text-align: right;
    }

    .footer {
      text-align: center;
      font-size: 10px;
      color: #777;
      border-top: 1px solid #eee;
      padding-top: 5px;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <!-- Header -->
  <div class="header">
    <img src="https://api.astrovedvaani.com/uploads/ved.png" alt="Astrovedvaani Logo" />

    <div class="company-details">
      <strong>Vedvaani</strong><br>

       C/35, Shila Kuty, Hajipur Jadhua Road,<br>
      Professor Colony, Hajipur,<br>
      Vaishali, Bihar - 844101<br>

      ✉ support@vedvaani.com <br>

      ☎ +91 9667002566
    </div>
  </div>

  <!-- Invoice Info -->
  <h2>Invoice #<%= invoice.invoice_number %></h2>
  <p>Date: <%= new Date(invoice.issued_at).toLocaleDateString() %></p>

  <!-- Addresses -->
  <div class="addresses" style="display: flex; justify-content: space-between; margin-bottom: 20px; gap: 60px;">

    <div class="dealer" style="width: 48%;">
      <strong>Dealer / Seller:</strong><br>

      Vedvaani <br>

      C/35, Shila Kuty, Hajipur Jadhua Road,<br>
      Professor Colony, Hajipur,<br>
      Vaishali, Bihar - 844101 <br>

      support@vedvaani.com <br>

      +91 9667002566
    </div>

    <div class="billing" style="width: 48%; padding-left: 20px; border-left: 1px solid #ddd;">
      <strong>Billing Address:</strong><br>

      <%= invoice.address_snapshot.full_name %><br>

      <%= invoice.address_snapshot.address_line1 %>,
      <%= invoice.address_snapshot.city %><br>

      <%= invoice.address_snapshot.state %> -
      <%= invoice.address_snapshot.pincode %><br>

      Mobile: <%= invoice.address_snapshot.mobile_number %>
    </div>
  </div>

  <!-- Product Details -->
  <table>
    <tr>
      <th>Product</th>
      <th>SKU</th>
      <th>Price (₹)</th>
      <th>Discount (%)</th>
      <th>GST (%)</th>
      <th>Delivery (₹)</th>
      <th>Final Price (₹)</th>
      <th>Qty</th>
      <th>Total (₹)</th>
    </tr>

    <tr>
      <td><%= product.name || "N/A" %></td>
      <td><%= product.sku || "N/A" %></td>
      <td><%= invoice.price_snapshot.selling_price %></td>
      <td><%= invoice.price_snapshot.discount %></td>
      <td><%= invoice.price_snapshot.gst_percent %></td>
      <td><%= invoice.price_snapshot.delivery_charge %></td>
      <td><%= invoice.price_snapshot.final_price %></td>
      <td><%= invoice.price_snapshot.quantity %></td>
      <td><%= invoice.price_snapshot.total_payable %></td>
    </tr>
  </table>

  <!-- Totals -->
  <table class="total-table">
    <tr>
      <th>Total Payable:</th>
      <td>₹<%= invoice.price_snapshot.total_payable %></td>
    </tr>
  </table>

  <div class="footer">
    This is a computer-generated invoice. Thank you for shopping with Vedvaani.
  </div>
</body>

</html>